{
	"name": "type-safe-env",
	"version": "1.0.0",
	"description": "A lightweight, zero-dependency library to load, validate, and safely use environment variables in TypeScript — with full type inference and runtime validation.",
	"license": "MIT",
	"author": "Jean Le Rocher <jlerocher@gmail.com>",
	"type": "module",
	"keywords": [
		"env",
		"type-safe",
		"parser",
		"variables"
	],
	"homepage": "https://github.com/jlerocher/type-safe-env#readme",
	"bugs": {
		"url": "https://github.com/jlerocher/type-safe-env/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jlerocher/type-safe-env.git"
	},
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"test": "bun test"
	},
	"private": true,
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
